{
  "manifest_version": 3,
  "name": "SuperFlex",
  "version": "1.0.0",
  "description": "Custom styled extension",
  "icons": {
    "16": "public/favicon.png",
    "32": "public/favicon.png",
    "48": "public/favicon.png",
    "128": "public/favicon.png"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/content.jsx-loader-C7B8ARyb.js"
      ],
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ],
      "css": [
        "assets/content-Di5oeWJw.css"
      ]
    }
  ],
  "host_permissions": [
    "https://flexstudent.nu.edu.pk/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "public/*"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://flexstudent.nu.edu.pk/*"
      ],
      "resources": [
        "assets/content.jsx-CXi21CSD.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
